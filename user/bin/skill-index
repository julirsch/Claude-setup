#!/usr/bin/env bash
# skill-index: keep skills cheap. Each skill is stored as a guide inside an "index skill", so only
# the index's short description is in context every turn; the index table and the guide itself are
# read only when a task needs them (progressive disclosure).
#
# Usage:
#   skill-index add <owner/repo | dir> [path/to/skill] [--group G] [--tag "when to use"] [--project] [--force]
#       Add ONE skill as a guide in group G (default: toolkit).
#   skill-index bundle <owner/repo | dir> <skills-subdir> <group> "<description>" [--project] [--force]
#       Turn a whole collection of skills into one index skill named <group>.
#   skill-index adopt <skill-name> [--group G] [--tag "..."] [--project]
#       Move an existing standalone skill from skills/ into an index.
#   skill-index remove <group> <skill-name> [--project]
#   skill-index rebuild [group] [--project]     Regenerate index tables after editing guides.
#   skill-index list [--project]
#
# Scope: ~/.claude/skills (or $CLAUDE_HOME/skills); --project uses ./.claude/skills.
# Nothing fetched is executed. Files containing code are listed for review.
set -euo pipefail

MARK="generated by skill-index"
usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

# ---- args ------------------------------------------------------------------
CMD=${1:-}; [[ -n $CMD ]] || usage; shift
POS=(); GROUP=""; TAG=""; PROJECT=0; FORCE=0
while (( $# )); do
  case $1 in
    --group) GROUP=${2:?}; shift 2;;
    --tag) TAG=${2:?}; shift 2;;
    --project) PROJECT=1; shift;;
    --force) FORCE=1; shift;;
    -h|--help) usage 0;;
    *) POS+=("$1"); shift;;
  esac
done
if (( PROJECT )); then BASE=./.claude/skills; else BASE="${CLAUDE_HOME:-$HOME/.claude}/skills"; fi
BACKUPS="$(dirname "$BASE")/skill-backups"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
command -v jq >/dev/null || { echo "skill-index needs jq"; exit 1; }

valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "invalid name '$1' (use lowercase letters, digits, hyphens)"; exit 1; }; }
backup() { mkdir -p "$BACKUPS"; mv "$1" "$BACKUPS/$(basename "$1")-$(date +%Y%m%d-%H%M%S)"; echo "previous copy moved to $BACKUPS/"; }

# Read one frontmatter field (single-line, quoted, or folded >/| values).
field() { awk -v k="$2" '
  NR==1 && /^---/ {fm=1; next}  fm && /^---/ {exit}
  fm && grab && /^[ \t]+/ {sub(/^[ \t]+/,""); v=v" "$0; next}
  fm && grab {exit}
  fm && $0 ~ "^"k":" {sub("^"k":[ \t]*",""); if ($0 ~ /^[>|][-+]?$/ || $0=="") {grab=1; v=""} else {v=$0; exit}}
  END {gsub(/^[ \t]+|[ \t]+$/,"",v); if (v ~ /^".*"$/ || v ~ /^\x27.*\x27$/) v=substr(v,2,length(v)-2); print v}' "$1"; }

# fetch <owner/repo | dir> [subpath] -> sets FETCHED (a directory) and REV
fetch() {
  local src=$1 sub=${2:-}; REV=""
  if [[ -d $src ]]; then FETCHED="$src${sub:+/$sub}"; return; fi
  [[ $src =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { echo "source must be a directory or owner/repo, got '$src'"; exit 1; }
  echo "fetching $src${sub:+ ($sub)} ..."
  git clone -q --depth 1 --filter=blob:none ${sub:+--sparse} "https://github.com/$src" "$TMP/repo"
  [[ -n $sub ]] && git -C "$TMP/repo" sparse-checkout set "$sub" >/dev/null
  REV=$(git -C "$TMP/repo" rev-parse --short HEAD)
  FETCHED="$TMP/repo${sub:+/$sub}"
}

list_code() {
  local s; s=$(find "$1" -type f \( -name '*.sh' -o -name '*.py' -o -name '*.js' -o -name '*.ts' -o -perm -u+x \) | sed "s|$1/||" | head -20)
  [[ -n $s ]] && { echo "note: bundled files containing code (review before letting Claude run them):"; echo "$s" | sed 's/^/  /'; }
  return 0
}

meta() { echo "$BASE/$1/index.json"; }
ensure_meta() { [[ -f $(meta "$1") ]] || { mkdir -p "$BASE/$1"; echo '{"description":null,"entries":{}}' > "$(meta "$1")"; }; }

# ---- index generation --------------------------------------------------------
rebuild() {
  local g=$1 gd="$BASE/$1" m desc rows="" n=0 f dir rel nm d tag
  m=$(meta "$g"); [[ -f $m ]] || { echo "no index '$g' in $BASE"; return 1; }
  while IFS= read -r f; do
    dir=$(dirname "$f"); rel=${dir#"$gd/"}
    nm=$(field "$f" name); nm=${nm:-$(basename "$dir")}
    d=$(field "$f" description); d=${d//|/\\|}; (( ${#d} > 200 )) && d="${d:0:197}..."
    rows+="| \`$nm\` | $d | \`$rel/GUIDE.md\` |"$'\n'; n=$((n+1))
  done < <(find "$gd/guides" -name GUIDE.md 2>/dev/null | sort)
  desc=$(jq -r '.description // empty' "$m")
  if [[ -z $desc ]]; then
    desc=$(jq -r '[.entries | to_entries[] | "\(.value.tag // .key) (\(.key))"] | join("; ")' "$m")
    desc="On-demand guides for: $desc. Read this index first for tasks like these."
  fi
  (( ${#desc} > 700 )) && echo "warning: '$g' description is ${#desc} chars (loaded every turn); consider splitting into --group's"
  {
    printf -- '---\nname: %s\ndescription: %s\n---\n\n' "$g" "$(jq -Rn --arg d "$desc" '$d')"
    printf '<!-- %s; edit guides, then run: skill-index rebuild %s -->\n# %s guide index (%d guides)\n\n' "$MARK" "$g" "$g" "$n"
    cat <<'EOF'
How to use this index:
1. Pick the 1–3 guides below that best match the task. Don't read them all.
2. Read each chosen guide at the path shown, relative to this skill's directory.
3. Paths inside a guide (scripts/, references/) are relative to that guide's own folder.
4. If a guide mentions another skill by name, look it up in this table and read that guide too.
5. If nothing fits, carry on without a guide.

| Guide | Use when | Path |
|---|---|---|
EOF
    printf '%s' "$rows"
  } > "$gd/SKILL.md"
  echo "index '$g': $n guides; always-on cost ~$(( (${#desc}+3)/4 )) tokens -> $gd"
}

do_add() {  # do_add <owner/repo | dir> [subpath]
    fetch "$1" "${2:-}"
    [[ -f $FETCHED/SKILL.md ]] || { echo "no SKILL.md in $1 ${2:-}"; exit 1; }
    name=$(field "$FETCHED/SKILL.md" name); name=${name:-$(basename "$FETCHED")}; valid_name "$name"
    g=${GROUP:-toolkit}; valid_name "$g"; ensure_meta "$g"
    dest="$BASE/$g/guides/$name"
    if [[ -e $dest ]]; then (( FORCE )) || { echo "'$name' already in '$g' (use --force to replace)"; exit 1; }; backup "$dest"; fi
    mkdir -p "$BASE/$g/guides"; cp -R "$FETCHED" "$dest"; rm -rf "$dest/.git"; mv "$dest/SKILL.md" "$dest/GUIDE.md"
    jq --arg n "$name" --arg t "$TAG" --arg s "$1" --arg p "${2:-}" --arg r "$REV" \
      '.entries[$n] = {tag: (if $t == "" then null else $t end), source: $s, path: $p, rev: $r}' "$(meta "$g")" > "$TMP/m" && mv "$TMP/m" "$(meta "$g")"
    echo "added '$name' to index '$g'"; list_code "$dest"; rebuild "$g"
}

# ---- commands ----------------------------------------------------------------
case $CMD in
  add)
    [[ ${#POS[@]} -ge 1 ]] || usage
    do_add "${POS[0]}" "${POS[1]:-}";;

  bundle)
    [[ ${#POS[@]} -eq 4 ]] || usage
    g=${POS[2]}; valid_name "$g"; fetch "${POS[0]}" "${POS[1]}"
    [[ -d $FETCHED ]] || { echo "no such directory: ${POS[1]}"; exit 1; }
    [[ -n $(find "$FETCHED" -name SKILL.md -print -quit) ]] || { echo "no SKILL.md files under ${POS[1]}"; exit 1; }
    if [[ -e $BASE/$g ]]; then (( FORCE )) || { echo "$BASE/$g exists (use --force to replace)"; exit 1; }; backup "$BASE/$g"; fi
    mkdir -p "$BASE/$g/guides"; cp -R "$FETCHED"/. "$BASE/$g/guides/"; rm -rf "$BASE/$g/guides/.git"
    find "$BASE/$g/guides" -name SKILL.md -execdir mv SKILL.md GUIDE.md \;
    jq -n --arg d "${POS[3]}" --arg s "${POS[0]}" --arg p "${POS[1]}" --arg r "$REV" \
      '{description: $d, bundle: {source: $s, path: $p, rev: $r}, entries: {}}' > "$(meta "$g")"
    list_code "$BASE/$g/guides"; rebuild "$g";;

  adopt)
    [[ ${#POS[@]} -eq 1 ]] || usage
    src="$BASE/${POS[0]}"; [[ -f $src/SKILL.md ]] || { echo "no standalone skill at $src"; exit 1; }
    grep -q "$MARK" "$src/SKILL.md" && { echo "'${POS[0]}' is already an index"; exit 1; }
    cp -R "$src" "$TMP/adopt"; backup "$src"
    do_add "$TMP/adopt"
    jq --arg n "$name" --arg s "adopted from skills/${POS[0]}" '.entries[$n].source = $s' "$(meta "$g")" > "$TMP/m" && mv "$TMP/m" "$(meta "$g")";;

  remove)
    [[ ${#POS[@]} -eq 2 ]] || usage
    g=${POS[0]} n=${POS[1]}; [[ -d $BASE/$g/guides/$n ]] || { echo "no guide '$n' in '$g'"; exit 1; }
    backup "$BASE/$g/guides/$n"
    jq --arg n "$n" 'del(.entries[$n])' "$(meta "$g")" > "$TMP/m" && mv "$TMP/m" "$(meta "$g")"
    if [[ -n $(find "$BASE/$g/guides" -name GUIDE.md -print -quit) ]]; then rebuild "$g"; else backup "$BASE/$g"; echo "index '$g' was empty and has been removed"; fi;;

  rebuild)
    if [[ ${#POS[@]} -ge 1 ]]; then rebuild "${POS[0]}"
    else for m in "$BASE"/*/index.json; do [[ -e $m ]] && rebuild "$(basename "$(dirname "$m")")"; done; fi;;

  list)
    for d in "$BASE"/*/; do
      [[ -f $d/SKILL.md ]] || continue; nm=$(basename "$d")
      if grep -q "$MARK" "$d/SKILL.md"; then
        printf '%-20s index, %3d guides, ~%d tokens/turn\n' "$nm" "$(find "$d/guides" -name GUIDE.md | wc -l)" "$(( ($(field "$d/SKILL.md" description | wc -c)+3)/4 ))"
      else
        printf '%-20s standalone skill, ~%d tokens/turn  (skill-index adopt %s)\n' "$nm" "$(( ($(field "$d/SKILL.md" description | wc -c)+3)/4 ))" "$nm"
      fi
    done;;

  *) usage;;
esac
